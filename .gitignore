# ==========================================
# FRONTEND (React / Node / Next.js)
# ==========================================

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# build outputs
.next/
out/
build/
dist/

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (local secrets shouldn't be committed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel/

# ==========================================
# BACKEND (ASP.NET Core / C#)
# ==========================================

# Build results
[Bb]in/
[Oo]bj/

# Visual Studio & IDE specific files
.vs/
.vscode/
*.user
*.userosscache
*.sln.docstates
*.suo

# Test results and logs
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Local Configuration (prevents committing local DB connections)
appsettings.Development.json
appsettings.Local.json

# ==========================================
# OS / MISC
# ==========================================
.DS_Store
*.pem
Thumbs.db